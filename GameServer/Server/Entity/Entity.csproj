<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Entity</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fantasy-Net" Version="2026.0.1007" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.1.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Gate\" />
  </ItemGroup>

  <!-- 双端共享代码：通过链接引用 Unity 项目中的 GameShared 源码 -->
  <ItemGroup>
    <Compile Include="..\..\..\UnityProject\Assets\GameScripts\HotFix\GameShared\**\*.cs" Exclude="**\*.asmdef;**\*.meta;**\Tests\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\..\UnityProject\Assets\GameScripts\HotFix\GameLogic\Battle\BattleSnapshotProtocolMapper.cs" Link="GameLogic\BattleSnapshotProtocolMapper.cs" />
    <Compile Include="..\..\..\UnityProject\Assets\GameScripts\HotFix\GameLogic\Battle\BattleSimulation.cs" Link="GameLogic\BattleSimulation.cs" />
    <Compile Include="..\..\..\UnityProject\Assets\GameScripts\HotFix\GameLogic\Battle\PredictionErrorSmoother.cs" Link="GameLogic\PredictionErrorSmoother.cs" />
    <Compile Include="..\..\..\UnityProject\Assets\GameScripts\HotFix\GameLogic\Battle\BattlePredictionSelfTestSuite.cs" Link="GameLogic\BattlePredictionSelfTestSuite.cs" />
    <Compile Include="..\..\..\UnityProject\Assets\GameScripts\HotFix\GameLogic\Battle\BattlePredictionSelfTestSuite.Rtt.cs" Link="GameLogic\BattlePredictionSelfTestSuite.Rtt.cs" />

  </ItemGroup>

</Project>
